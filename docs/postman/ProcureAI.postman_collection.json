{
  "info": {
    "name": "ProcureAI",
    "description": "PayPal AI Hackathon — marketplace + payables API (sandbox). Keep amounts ≤ $2 (DEMO_MAX_USD).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "ownerKey", "value": "{{OWNER_API_KEY}}" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Negotiations — list",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-owner-key", "value": "{{ownerKey}}" }],
        "url": "{{baseUrl}}/api/negotiations"
      }
    },
    {
      "name": "Negotiations — queue ≤$2",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-owner-key", "value": "{{ownerKey}}" },
          { "key": "content-type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brief\": \"1 demo micro pack (Postman smoke)\",\n  \"priority\": \"balanced\",\n  \"quantity\": 1,\n  \"maxUnitPrice\": \"2.00\",\n  \"currency\": \"USD\",\n  \"neededByDays\": 14,\n  \"idempotencyKey\": \"postman-{{$guid}}\"\n}"
        },
        "url": "{{baseUrl}}/api/negotiations"
      }
    },
    {
      "name": "Invoices — extract sample",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-owner-key", "value": "{{ownerKey}}" },
          { "key": "content-type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"INVOICE INV-DEMO-150\\nVendor: BundleBits\\nTotal due: 1.50 USD\\n\"\n}"
        },
        "url": "{{baseUrl}}/api/invoices/extract"
      }
    },
    {
      "name": "FX normalize",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-owner-key", "value": "{{ownerKey}}" },
          { "key": "content-type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"base\": \"USD\",\n  \"maxUnitPrice\": 2,\n  \"neededByDays\": 21,\n  \"quotes\": [\n    { \"supplier\": \"US\", \"unitPrice\": 1.8, \"currency\": \"USD\", \"leadTimeDays\": 10 },\n    { \"supplier\": \"SG\", \"unitPrice\": 2.4, \"currency\": \"SGD\", \"leadTimeDays\": 12 }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/stretch/fx/normalize"
      }
    },
    {
      "name": "Sponsors — status",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-owner-key", "value": "{{ownerKey}}" }],
        "url": "{{baseUrl}}/api/sponsors/status"
      }
    },
    {
      "name": "Sponsors — agents (Astropods registry)",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-owner-key", "value": "{{ownerKey}}" }],
        "url": "{{baseUrl}}/api/sponsors/agents"
      }
    }
  ]
}
