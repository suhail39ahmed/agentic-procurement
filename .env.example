PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

API_PORT=4000
ADMIN_API_KEY=

PAYPAL_SANDBOX_PASSWORD=
OWNER_BUYER_EMAIL=owner-buyer@business.example.com
SELLER_A_EMAIL=seller-a@business.example.com
SELLER_B_EMAIL=seller-b@business.example.com
SELLER_C_EMAIL=seller-c@business.example.com
SELLER_D_EMAIL=seller-d@business.example.com
CLIENT_EMAIL=client-agentic@personal.example.com
# Order totals above this require human approval.
POLICY_APPROVAL_THRESHOLD=250
POLICY_MAX_ORDER_TOTAL=10000
MANDATE_SECRET=
OWNER_ID=
OWNER_API_KEY=
DATABASE_URL=

# Stretch: Slack approval cards (#39)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=

# Stretch: FX rates are sandbox static (USD/SGD/INR) — see apps/api/src/fx.ts

# Optional hard amount ceiling for testing. Leave unset/off so approval-threshold handles large orders.
# Set to 250 while testing if you want a temporary hard stop; raise or clear later.
DEMO_MAX_USD=250

# Sponsor integrations (optional — features degrade when unset)
CHANNEL3_API_KEY=
CHANNEL3_API_BASE=https://api.trychannel3.com
KERNEL_API_KEY=
KERNEL_API_BASE=https://api.onkernel.com

# Bryntum Gantt Enterprise (set on WEB service / apps/web .env.local — client-side)
# Accepts either name; next.config maps VITE_ → NEXT_PUBLIC_
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=
VITE_BRYNTUM_LICENSE_KEY=

# PayPal JS SDK buttons use PAYPAL_CLIENT_ID from the API via /api/paypal/browser-config
# (client id is public by design). No separate web secret required.
